generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
}

model Medicine {
  id            String            @id @default(uuid())
  name          String            @unique
  unit          String
  packType      String            @default("strip")
  unitsPerPack  Int               @default(1)
  category      MedicineCategory  @default(ALLOPATHIC)
  gstPercent    Float             @default(0)
  mrp           Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  batches       MedicineBatch[]
  prescriptionItems PrescriptionItem[]
}

model MedicineBatch {
  id                String    @id @default(uuid())
  medicineId        String
  medicine          Medicine  @relation(fields: [medicineId], references: [id])
  batchNumber       String    @unique
  manufacturingDate DateTime
  expiryDate        DateTime
  purchasePrice     Float     // cost per unit for this delivery
  stockUnits        Int       // stock in individual units
  supplierId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum MedicineCategory {
  ALLOPATHIC
  AYURVEDIC
  HOMEOPATHIC
  VETERINARY
  SURGICAL
  COSMETIC
  PERSONAL_CARE
  FOOD_SUPPLEMENT
  BABY_CARE
  GENERAL_STORE
  OTHER
}
model Customer {
  id            String         @id @default(uuid())
  name          String
  phoneNumber   String         @unique
  email         String?
  notes         String?
  loyaltyPoints Int            @default(0)
  totalSpend    Float          @default(0)
  createdAt     DateTime       @default(now())
  prescriptions Prescription[]
}

model Prescription {
  id         String             @id @default(uuid())
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id])
  doctorName String?
  notes      String?
  discount   Float              @default(0)
  subTotal   Float
  gstAmount  Float              @default(0)
  total      Float
  status     PrescriptionStatus @default(PENDING)
  date       DateTime           @default(now())
  items      PrescriptionItem[]
}
model PrescriptionItem {
  id             String         @id @default(uuid())
  prescriptionId String
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  medicineId     String
  medicine       Medicine       @relation(fields: [medicineId], references: [id])
  batchId        String?
  quantity       Int            // in base units (tablets/ml)
  pricePerUnit   Float          @default(0)
  gstPercent     Float          @default(0)
  sellAsPackOf   Int            @default(1) // 1=per unit, or unitsPerPack=per strip
}

model Supplier {
  id              String          @id @default(uuid())
  name            String
  contactPerson   String?
  phone           String          @unique
  email           String?
  address         String?
  gstNumber       String?
  discountPercent Float           @default(0)
  createdAt       DateTime        @default(now())
  purchaseOrders  PurchaseOrder[]
  medicines       SupplierMedicine[]
}

model SupplierMedicine {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  medicineName String
  pricePerUnit Float
  updatedAt   DateTime @updatedAt

  @@unique([supplierId, medicineName])
}

model PurchaseOrder {
  id               String        @id @default(uuid())
  supplierId       String
  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  status           PurchaseStatus @default(PENDING)
  totalCost        Float
  orderDate        DateTime      @default(now())
  expectedDelivery DateTime?
  receivedDate     DateTime?
  notes            String?
  items            PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  medicineName    String
  batchNumber     String?
  manufacturingDate DateTime?
  expiryDate      DateTime?
  quantity        Int
  pricePerUnit    Float
  sellingPrice    Float?
  gstPercent      Float?
  totalPrice      Float
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum Role {
  OWNER
  EMPLOYEE
  ADMIN
}

enum MedicineStatus {
  OK
  LOW
  CRITICAL
}

enum PrescriptionStatus {
  PENDING
  PAID
  REJECTED
}